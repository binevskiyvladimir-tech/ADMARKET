# AI provider (optional for local fallback mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Required for production: use a long random value, never commit a real secret.
SESSION_SECRET=replace-with-a-long-random-secret-before-deployment
COOKIE_SECURE=0

# Optional first-run admin bootstrap. Use a strong password (12+ chars).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# v0.9 payment adapter is sandbox-only; no external gateway is called.
PAYMENT_MODE=test
# For a future provider integration, use provider-issued test credentials only.
PAYMENT_PROVIDER=sandbox

# Sandbox webhook HMAC secret (minimum 24 characters); never use for live payments
SANDBOX_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# v2.5 Yandex Direct OAuth (optional; use HTTPS callback in production)
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=
YANDEX_DIRECT_REDIRECT_URI=https://your-domain.example/integrations/yandex-direct/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
